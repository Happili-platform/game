# GAMe local Docker deployment
# Copy to .env and set absolute paths appropriate for your machine.

GAME_DATA_DIR=/absolute/path/to/game-data
GAME_VAULT_DIR=/absolute/path/to/game-vault

# Set this to your Docker bridge gateway if needed.
GAME_LOCAL_DOCKER_GATEWAY=172.18.0.1

# Optional Google Agent Engine integration:
# COMPOSE_FILE=compose.yaml:compose.google-adc.yaml
# GOOGLE_ADC_FILE=/absolute/path/to/application_default_credentials.json
